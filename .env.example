# Course OpenAI-compatible endpoint. Copy this file to .env, then use the
# base URL and key distributed for the course.
OPENAI_BASE_URL=replace-with-course-base-url
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731

# The OpenAI SDK already retries transient failures twice. The harness raises
# this to five by default; override it here only when debugging provider issues.
OPENAI_MAX_RETRIES=5

# Official api.deepseek.com only: action requests default to low reasoning.
# Options: none, low, high, max. Summaries use non-thinking mode.
# The harness translates output budgets to DeepSeek's max_tokens parameter.
DEEPSEEK_REASONING_EFFORT=low
# Total action output budget, including reasoning and tool arguments. Increase
# explicitly for harder tasks; summaries keep their separate 1200-token cap.
DEEPSEEK_MAX_TOKENS=8192

# Optional local HTTP proxy for model requests and Modal sandbox commands.
# Set these to your proxy's actual address when direct access is unavailable.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,::1
